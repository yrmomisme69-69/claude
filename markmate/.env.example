# 必填：你喺 Claude Console 攞到嘅 API key（只會放喺伺服器，用家睇唔到）
ANTHROPIC_API_KEY=

# 選填：用邊個模型改卷（預設 claude-sonnet-5-5；想平好多可以用 claude-haiku-5-5）
CLAUDE_MODEL=claude-sonnet-5-5

# 選填：思考深度 low / medium / high（預設 medium）
CLAUDE_EFFORT=medium

# 建議：入場密碼。設咗之後，要輸入密碼先用到，防止陌生人用你嘅額度
ACCESS_CODE=

# 建議：全站每日最多用幾多美金（預設 2，即約 HK$15）。到咗就停，聽日自動重置。0 = 唔設上限
DAILY_BUDGET_USD=2

# 選填：每個人（IP）每日最多改幾多頁（預設 40）
DAILY_PAGE_LIMIT=40

# 建議：管理員密碼，用嚟開 /admin 睇每日用量
ADMIN_CODE=

# 選填：每日幾點重置，用邊個時區（預設 Asia/Hong_Kong）
APP_TIMEZONE=Asia/Hong_Kong

# 建議：連接 Upstash Redis 後 Vercel 會自動加呢兩個（或者 KV_REST_API_URL / KV_REST_API_TOKEN）。
# 有咗佢，用量上限喺重新部署之後都唔會清零。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
